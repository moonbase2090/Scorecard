# Scorecard configuration.
# pack = "rust"   # rust, node, python, bash, go, java, csharp, php, cpp, web, or command
# Set this when the repo contains more than one manifest. Same as --pack.
# Copy to analyzer.toml at the root of the project you analyze (the path given to
# `sc analyze`, usually the repo root), or to ~/.config/sc/analyzer.toml. Parent and
# sub-directories are not searched. --config PATH overrides both.
# CLI flags override the matching settings.

[gates]
# `spec` and `mutation` run only when `--spec` or `--mutation` asks for them.
fail_on = ["types", "tests", "crap", "secrets", "lint"]
crap_threshold = 30
# Every src function at or above this CC with 0% coverage fails the crap
# gate (`complexity.untested`). This is the whole src tree until --diff exists.
new_fn_untested_cc = 15

[scope]
# Rust complexity walks src/**/*.rs. Paths are relative to the project root.
exclude = ["target/**", "generated/**"]

[mutation]
mode = "off"
max_mutants = 50
budget_seconds = 180

[llm]
enabled = false
# ollama (default, local), cursor, or openai-compatible.
# cursor sends the spec and files the agent reads to Cursor.
# openai-compatible sends the spec and tool-read file text to base_url.
# The API key stays in the named env var.
backend = "ollama"
endpoint = "http://127.0.0.1:11434/v1"
model = "qwen2.5-coder"
base_url = "https://openrouter.ai/api/v1"
api_key_env = "OPENROUTER_API_KEY"

[engines]
coverage = true
sca = true

[html]
# auto | on | off. auto enforces html on the built-in fail_on list.
enforce = "auto"

[links]
# Missing internal files stay advisory until this is true or fail_on names links.
enforce = false

[a11y]
# Advisory until this is true or fail_on names a11y. disable lists rule ids.
enforce = false
disable = []

[commands]
# Empty skips lint. Non-zero exit is `lint.failed`.
# Add `lint` to `gates.fail_on` to make that exit fail the process.
lint = "cargo clippy -- -D warnings"
