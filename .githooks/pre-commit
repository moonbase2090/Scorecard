#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
trap 'exit 1' HUP INT TERM

git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs' > "$snapshot/rust-files"
git diff --cached --name-only --diff-filter=ACMR -z -- \
    '*.js' '*.mjs' '*.cjs' '*.jsx' '*.ts' '*.tsx' '*.json' '*.jsonc' > "$snapshot/web-files"
if [ ! -s "$snapshot/rust-files" ] && [ ! -s "$snapshot/web-files" ]; then
    exit 0
fi

# Export manifests, formatter configuration, and sources from the same index.
mkdir "$snapshot/tree"
git checkout-index --all --prefix="$snapshot/tree/"
cd "$snapshot/tree"
failed=0

if [ -s "$snapshot/rust-files" ]; then
    if ! command -v cargo >/dev/null 2>&1; then
        echo 'pre-commit: cargo is missing. Install Rust and run rustup component add rustfmt.' >&2
        exit 1
    fi
    if ! cargo fmt --all -- --check; then
        echo 'pre-commit: staged Rust workspace failed formatting. Run cargo fmt --all, stage the formatted files with git add, and retry.' >&2
        failed=1
    fi
fi

if [ -s "$snapshot/web-files" ]; then
    if ! command -v npx >/dev/null 2>&1; then
        echo 'pre-commit: npx is missing. Install Node.js with npm to check staged web files.' >&2
        exit 1
    fi
    if ! xargs -0 npx --yes @biomejs/biome@2.6.2 format \
        --vcs-enabled=false --no-errors-on-unmatched -- < "$snapshot/web-files"; then
        echo 'pre-commit: staged web files failed formatting. Run npx --yes @biomejs/biome@2.6.2 format --write <files>, stage the formatted files with git add, and retry.' >&2
        failed=1
    fi
fi

exit "$failed"
